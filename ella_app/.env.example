# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Ella API. The production API is used by default when this is omitted.
ELLA_API_BASE_URL=https://ella.navgurukul.org/api

# Supabase project — find in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# llm-proxy Edge Function URL (same base URL + /functions/v1/llm-proxy)
LLM_PROXY_URL=

# Google OAuth client ID. Leave blank unless Google sign-in is configured.
GOOGLE_CLIENT_ID=
