# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase project — find in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# llm-proxy Edge Function URL (same base URL + /functions/v1/llm-proxy)
LLM_PROXY_URL=https://<your-project-ref>.supabase.co/functions/v1/llm-proxy
